# Secrets for the GPT capstone, as environment variables.
# Copy to ~/.config/mygpt/secrets.env (NOT into the project repo), fill in, then:
#   chmod 600 ~/.config/mygpt/secrets.env
#   set -a; . ~/.config/mygpt/secrets.env; set +a
#   python tools/check_accounts.py
# The R2 keys live in a second file, ~/.config/mygpt/r2.env, created in lesson 02.2.
# Every value here is also stored in your password manager. Never paste them into git,
# notebooks, Docker images, W&B configs, screenshots or chats.

# Hugging Face fine-grained token, read-only (lesson 01.2). Starts with hf_
HF_TOKEN=

# Weights & Biases API key from https://wandb.ai/authorize (lesson 01.2)
WANDB_API_KEY=

# LLM judge for Module 10. Fill in the one you use; leave the other empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Not a secret: your names, used by commands in later lessons.
HF_USER=
GITHUB_USER=
