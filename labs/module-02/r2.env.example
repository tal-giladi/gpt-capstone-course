# rclone remote "r2" defined entirely by environment variables (nothing written to rclone.conf).
# Copy to ~/.config/mygpt/r2.env (NOT into the project repo), fill in, `chmod 600`, then:
#   set -a; . ~/.config/mygpt/r2.env; set +a
#   rclone lsf r2:mygpt     (not `lsd r2:`: a bucket-scoped token cannot list buckets)
# Values come from Cloudflare dashboard -> R2 -> Manage API tokens (lesson 02.2).

RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=paste-access-key-id
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=paste-secret-access-key
RCLONE_CONFIG_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_REGION=auto
RCLONE_CONFIG_R2_ACL=private
# Needed for bucket-scoped tokens: they cannot create/check buckets, only objects.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

# The project bucket and its root, used by the lessons and scripts/sync.sh.
MYGPT_REMOTE=r2:mygpt

# ---------------------------------------------------------------------------------------------
# NOT using Cloudflare R2? Keep the remote NAME "r2" so every command in the course works as
# written. Replace the R2 block above with two remotes: "store" = your real provider, and "r2" =
# an alias pointing at your bucket. Then r2:mygpt/... is stored as <your-bucket>/mygpt/... .
# Bucket names on B2, S3, GCS and Wasabi are global, so pick a unique one (e.g. mygpt-<you>-2026).
#
# RCLONE_CONFIG_R2_TYPE=alias
# RCLONE_CONFIG_R2_REMOTE=store:your-unique-bucket-name
# RCLONE_CONFIG_STORE_TYPE=s3
# RCLONE_CONFIG_STORE_ACCESS_KEY_ID=paste-key-id
# RCLONE_CONFIG_STORE_SECRET_ACCESS_KEY=paste-secret
# RCLONE_CONFIG_STORE_NO_CHECK_BUCKET=true
# ...plus ONE of these provider blocks (lesson 02.2, "Using another provider"):
#
# Backblaze B2 (S3 API; endpoint is shown on the bucket page):
# RCLONE_CONFIG_STORE_PROVIDER=Other
# RCLONE_CONFIG_STORE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# RCLONE_CONFIG_STORE_REGION=us-west-004
#
# Hetzner Object Storage (hel1, fsn1 or nbg1):
# RCLONE_CONFIG_STORE_PROVIDER=Hetzner
# RCLONE_CONFIG_STORE_ENDPOINT=https://hel1.your-objectstorage.com
# RCLONE_CONFIG_STORE_REGION=hel1
#
# Wasabi (use the endpoint of your bucket's region):
# RCLONE_CONFIG_STORE_PROVIDER=Wasabi
# RCLONE_CONFIG_STORE_ENDPOINT=https://s3.eu-central-2.wasabisys.com
# RCLONE_CONFIG_STORE_REGION=eu-central-2
#
# AWS S3:
# RCLONE_CONFIG_STORE_PROVIDER=AWS
# RCLONE_CONFIG_STORE_REGION=us-east-1
#
# Google Cloud Storage (S3 interoperability, HMAC key):
# RCLONE_CONFIG_STORE_PROVIDER=GCS
# RCLONE_CONFIG_STORE_ENDPOINT=https://storage.googleapis.com
#
# Hugging Face Storage Bucket (S3 credentials generated from an HF token):
# RCLONE_CONFIG_STORE_PROVIDER=Other
# RCLONE_CONFIG_STORE_ENDPOINT=https://YOUR_HF_NAMESPACE.s3.hf.co
# RCLONE_CONFIG_STORE_REGION=us-east-1
# RCLONE_CONFIG_STORE_FORCE_PATH_STYLE=true
# RCLONE_CONFIG_STORE_LIST_VERSION=2
# RCLONE_CONFIG_STORE_CHUNK_SIZE=256M
