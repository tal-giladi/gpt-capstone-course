# rclone remote "r2" defined entirely by environment variables (nothing written to rclone.conf).
# Copy to ~/.config/mygpt/r2.env (NOT into the project repo), fill in, `chmod 600`, then:
#   set -a; . ~/.config/mygpt/r2.env; set +a
#   rclone lsd r2:
# Values come from Cloudflare dashboard -> R2 -> Manage API tokens (lesson 02.2).

RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=paste-access-key-id
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=paste-secret-access-key
RCLONE_CONFIG_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_REGION=auto
RCLONE_CONFIG_R2_ACL=private
# Needed for bucket-scoped tokens: they cannot create/check buckets, only objects.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

# The project bucket and its root, used by the lessons and scripts/sync.sh.
MYGPT_REMOTE=r2:mygpt
